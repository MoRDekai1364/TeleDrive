<UserControl x:Class="TeleDrive.WPF.Views.Pages.TransfersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:TeleDrive.Core.Models;assembly=TeleDrive.Core">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Transfers" FontSize="22" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Transfers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:TransferItem}">
                        <Border Background="{DynamicResource PanelBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6"
                                Padding="16" Margin="0,0,0,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0">
                                    <Ellipse DockPanel.Dock="Left" Width="10" Height="10" Margin="0,0,10,0"
                                             Fill="{Binding Status, Converter={StaticResource TransferStatusToBrushConverter}}" />
                                    <TextBlock Text="{Binding Direction}" DockPanel.Dock="Right"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,0,0,0" />
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>

                                <ProgressBar Grid.Row="1" Height="8" Margin="0,10,0,6"
                                             Minimum="0" Maximum="{Binding TotalBytes}"
                                             Value="{Binding TransferredBytes, Mode=OneWay}" />

                                <DockPanel Grid.Row="2">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="Pause" Width="70" Margin="0,0,6,0"
                                                Command="{Binding DataContext.PauseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsInProgress, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <Button Content="Resume" Width="70" Margin="0,0,6,0"
                                                Command="{Binding DataContext.ResumeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsPaused, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        <Button Content="Cancel" Width="70"
                                                Command="{Binding DataContext.CancelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </StackPanel>

                                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="{Binding TransferredBytes, Converter={StaticResource ByteSizeConverter}, Mode=OneWay}" />
                                        <Run Text=" / " />
                                        <Run Text="{Binding TotalBytes, Converter={StaticResource ByteSizeConverter}, Mode=OneWay}" />
                                        <Run Text=" — " />
                                        <Run Text="{Binding Status, Mode=OneWay}" />
                                    </TextBlock>
                                </DockPanel>

                                <TextBlock Grid.Row="2" Text="{Binding ErrorMessage}"
                                           Foreground="{DynamicResource ErrorBrush}"
                                           HorizontalAlignment="Right" Margin="0,4,0,0"
                                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibilityConverter}}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
