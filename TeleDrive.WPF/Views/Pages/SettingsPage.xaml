<UserControl x:Class="TeleDrive.WPF.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="24" MaxWidth="480" HorizontalAlignment="Left">
        <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20" />

        <TextBlock Text="Connection" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
        <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20">
            <Run Text="{Binding ConnectionMode, Mode=OneWay}" />
            <Run Text=" — Vault channel " />
            <Run Text="{Binding VaultChannelId, Mode=OneWay}" />
        </TextBlock>

        <TextBlock Text="Theme" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
        <ComboBox ItemsSource="{Binding AvailableThemes}"
                  SelectedItem="{Binding SelectedTheme}"
                  Width="160" HorizontalAlignment="Left" Margin="0,0,0,20" />

        <TextBlock Text="Concurrent transfers" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
        <DockPanel Margin="0,0,0,20">
            <TextBlock DockPanel.Dock="Right" Text="{Binding ConcurrentTransferLimit}"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,0,0,0" />
            <Slider Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True"
                    Value="{Binding ConcurrentTransferLimit}" Width="220" HorizontalAlignment="Left" />
        </DockPanel>

        <TextBlock Text="Local cache" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
        <Button Content="Rebuild Cache" Width="140" HorizontalAlignment="Left"
                Command="{Binding ClearCacheCommand}" />

        <TextBlock Text="{Binding StatusMessage}" Margin="0,12,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}" />
    </StackPanel>
</UserControl>
