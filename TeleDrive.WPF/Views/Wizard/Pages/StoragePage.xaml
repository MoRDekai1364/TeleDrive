<UserControl x:Class="TeleDrive.WPF.Views.Wizard.Pages.StoragePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Vault storage" FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

        <RadioButton Content="Create a new private channel for me" IsChecked="{Binding UseExistingChannel, Converter={StaticResource InverseBoolConverter}}"
                     Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
        <RadioButton Content="Use an existing channel" IsChecked="{Binding UseExistingChannel}"
                     Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />

        <TextBox Text="{Binding ExistingChannelIdOrLink, UpdateSourceTrigger=PropertyChanged}"
                 Padding="6" Margin="0,4,0,12"
                 Visibility="{Binding UseExistingChannel, Converter={StaticResource BoolToVisibilityConverter}}"
                 Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                 BorderBrush="{DynamicResource BorderBrush}" />

        <Button Content="Set Up Storage" Width="140" HorizontalAlignment="Left"
                Command="{Binding SetupStorageCommand}" />

        <TextBlock Text="Working..." Margin="0,12,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibilityConverter}}" />

        <TextBlock Text="{Binding StatusMessage}" Margin="0,12,0,0"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibilityConverter}}" />
    </StackPanel>
</UserControl>
