<UserControl x:Class="TeleDrive.WPF.Views.Wizard.Pages.BotApiSetupPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Connect your Bot" FontSize="20" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4">
            1. Message @BotFather on Telegram and send /newbot
        </TextBlock>
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4">
            2. Copy the token it gives you
        </TextBlock>
        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16">
            3. Paste it below and verify
        </TextBlock>

        <TextBox Text="{Binding BotToken, UpdateSourceTrigger=PropertyChanged}"
                 Padding="8" Background="{DynamicResource SurfaceBrush}"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 BorderBrush="{DynamicResource BorderBrush}" />

        <Button Content="Test Connection" Width="160" HorizontalAlignment="Left" Margin="0,12,0,0"
                Command="{Binding TestConnectionCommand}" />

        <TextBlock Text="Validating..." Margin="0,8,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Visibility="{Binding IsValidating, Converter={StaticResource BoolToVisibilityConverter}}" />

        <TextBlock Text="{Binding ValidationMessage}" Margin="0,8,0,0"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   Visibility="{Binding ValidationMessage, Converter={StaticResource NullToVisibilityConverter}}" />
    </StackPanel>
</UserControl>
